#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage: bin/check [target ...] [--ci]

Targets:
  all             Run the full local verification set. Default.
  quick           Run fast handoff checks without the Next production build.
  scripts         Run root Bun tests for setup, doctor, and runtime config scripts.
  agent           Run the Python agent pytest suite.
  frontend        Run frontend lint, typecheck, and Bun tests.
  frontend-build  Run the Next production build.

Examples:
  bin/check quick
  bin/check scripts agent
  bin/check
USAGE
}

append_target() {
  local target="$1"
  local existing
  for existing in "${TARGETS[@]}"; do
    if [[ "$existing" == "$target" ]]; then
      return
    fi
  done
  TARGETS+=("$target")
}

expand_target() {
  case "$1" in
    all)
      append_target scripts
      append_target agent
      append_target frontend
      append_target frontend-build
      ;;
    quick)
      append_target scripts
      append_target agent
      append_target frontend
      ;;
    scripts | agent | frontend | frontend-build)
      append_target "$1"
      ;;
    *)
      echo "Unknown target: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
}

require_command() {
  local name="$1"
  if ! command -v "$name" >/dev/null 2>&1; then
    echo "Missing required command: $name" >&2
    exit 127
  fi
}

run_step() {
  local label="$1"
  shift
  printf '\n==> %s\n' "$label"
  "$@"
}

run_in() {
  local dir="$1"
  local label="$2"
  shift 2
  printf '\n==> %s\n' "$label"
  (cd "$dir" && "$@")
}

ARGS=()
for arg in "$@"; do
  case "$arg" in
    --help | -h)
      usage
      exit 0
      ;;
    --ci)
      ;;
    *)
      ARGS+=("$arg")
      ;;
  esac
done

TARGETS=()
if [[ "${#ARGS[@]}" -eq 0 ]]; then
  expand_target all
else
  for arg in "${ARGS[@]}"; do
    expand_target "$arg"
  done
fi

for target in "${TARGETS[@]}"; do
  case "$target" in
    scripts | frontend | frontend-build)
      require_command bun
      ;;
    agent)
      require_command uv
      ;;
  esac
done

for target in "${TARGETS[@]}"; do
  case "$target" in
    scripts)
      run_step "Root TypeScript tests" bun test "$REPO_ROOT"/scripts/*.test.ts
      ;;
    agent)
      run_in "$REPO_ROOT/agent" "Agent pytest" uv run pytest
      ;;
    frontend)
      run_in "$REPO_ROOT/frontend" "Frontend lint" bun run lint
      run_in "$REPO_ROOT/frontend" "Frontend typecheck" bun run typecheck
      run_in "$REPO_ROOT/frontend" "Frontend Bun tests" bun test
      ;;
    frontend-build)
      run_in "$REPO_ROOT/frontend" "Frontend production build" bun run build
      ;;
  esac
done

printf '\nAll requested checks passed.\n'
